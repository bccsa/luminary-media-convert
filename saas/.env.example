# SaaS service port
PORT=3001

# Auth0 configuration (required)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier

# CORS origins — comma-separated list of allowed origins (admin panel + web app)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# CouchDB connection URL (include credentials for authenticated access)
COUCHDB_URL=http://admin:password@localhost:5984

# CouchDB database name
COUCHDB_DATABASE=luminary

# Encoding API connection (required for session creation on behalf of web app users)
ENCODING_API_URL=http://localhost:3000
ENCODING_API_MASTER_KEY=change-me-to-a-random-secret

# SaaS Service URL (used as webhook callback URL for the Encoding API)
SAAS_SERVICE_URL=http://localhost:3001

# Shared secret for webhook authentication from the Encoding API
WEBHOOK_SECRET=change-me-to-a-webhook-secret

# Session history retention (days until completed/failed sessions expire)
SESSION_RETENTION_DAYS=30

# Cron schedule for expired session cleanup (default: daily at 3am)
# SESSION_EXPIRY_CRON=0 3 * * *

# Auth0 custom claim namespace — must match the Post Login Action in Auth0
AUTH0_CLAIM_NAMESPACE=https://luminary.dev

# Number of parallel S3 operations for file moves/renames (default: 10)
# S3_UPLOAD_CONCURRENCY=10

# Encryption key for S3 credentials stored in CouchDB (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
S3_ENCRYPTION_KEY=change-me-to-a-random-secret
