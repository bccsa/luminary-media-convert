{
    "name": "@luminary-media-converter/app",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build:libs": "(cd .. && npm -w hls run build && npm -w encode-config run build && npm -w segment-editor run build)",
        "build": "npm run build:libs && vue-tsc -b && vite build",
        "preview": "npm run build && wrangler dev",
        "test": "vitest run",
        "generate:pwa-icons": "pwa-assets-generator -p minimal-2023 public/favicon.svg",
        "deploy": "npm run build && wrangler deploy",
        "build:desktop": "npm run build:libs && vue-tsc -b && vite build --mode desktop"
    },
    "dependencies": {
        "@auth0/auth0-vue": "^2.5.0",
        "@luminary-media-converter/encode-config": "file:../encode-config",
        "@luminary-media-converter/hls": "file:../hls",
        "@luminary-media-converter/segment-editor": "file:../segment-editor",
        "tus-js-client": "^4.3.1",
        "video.js": "^8.23.7",
        "vue": "^3.5.0",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.37.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/video.js": "^7.3.58",
        "@vite-pwa/assets-generator": "^1.0.2",
        "@vitejs/plugin-vue": "^5.2.0",
        "@vue/test-utils": "^2.4.6",
        "jsdom": "^29.0.2",
        "tailwindcss": "^4.0.0",
        "typescript": "~5.7.0",
        "vite": "^6.1.0",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.0.18",
        "vue-tsc": "^2.2.0",
        "wrangler": "^4.92.0"
    }
}
