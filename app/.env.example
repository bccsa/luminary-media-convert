# Everything here is for browser development only.
#
# Both variables are read exclusively when `import.meta.env.DEV` is true, which
# no `vite build` ever sets. That is deliberate: Vite bakes every VITE_* value it
# finds into every bundle, so a build that consulted these would carry whichever
# values happened to be in this file on the machine that produced it — and a
# packaged release did exactly that until it was fixed.
# Nothing you put here can reach a packaged app, and nothing needs to: the API
# serves the client from its own origin and mints the token per launch.

# Base URL of the local Encoding API. Point it at whichever API you are running:
# 3000 for the standalone API (`npm run dev`), 31711 for the one hosted by the
# Electron main process (`npm run dev:electron`). Unset defaults to 3000.
VITE_API_URL=http://127.0.0.1:3000

# UI token for the Encoding API (sent as the X-API-Key header). Only needed
# outside Electron; the desktop app reads its token from the preload bridge
# (window.luminary.getApiToken()). Unset falls back to the same `dev-token` the
# API's own dev defaults accept, so a fresh clone runs without this file at all.
VITE_API_TOKEN=
