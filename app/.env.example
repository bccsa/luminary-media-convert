# Base URL of the local Encoding API.
# Leave unset in the packaged desktop app — the renderer is served from the
# same origin as the API. Set it when running the UI in a plain browser.
VITE_API_URL=http://localhost:31711

# UI token for the Encoding API (sent as the X-API-Key header).
# Only needed outside Electron; the desktop app reads its token from the
# preload bridge (window.luminary.getApiToken()).
VITE_API_TOKEN=
