# Auth0 configuration (required) — must match the SaaS Service's Auth0 tenant
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier

# SaaS Service URL — for session creation and management
# The Encoding API URL is returned by GET /saas/me (no separate env var needed)
VITE_SAAS_SERVICE_URL=http://localhost:3001

# Number of parallel tus upload streams (optional, default 5).
#
# SET THIS TO 1 IF THIS DEPLOYMENT ACCEPTS MULTI-GB UPLOADS.
# Parallel uploads finish with a tus concatenation POST that makes the server
# copy all parts into one file. For multi-GB files that copy takes minutes and
# exceeds the reverse proxy's request timeout: the proxy returns 502, tus-js
# retries the whole finalize, and every retry leaves another full-size copy in
# .tus-uploads until the disk fills ("no space left on device"). A value of 1
# uploads as a single resumable stream — only short 50 MB PATCH requests, no
# concatenation step, and roughly half the peak disk usage on the server.
#
# 5 is a reasonable default for deployments handling smaller files, where the
# concatenation step is near-instant.
#VITE_TUS_PARALLEL_UPLOADS=5
