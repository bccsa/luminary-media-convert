{
    "name": "@luminary-media-converter/player-native-example",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "description": "Player lab: the Web, Native and YouTube modes behind a Luminary-style build-time plugin, with stress tests and a health board",
    "scripts": {
        "dev": "vite",
        "dev:native": "VITE_NATIVE_IMPL_DIR=native-plugins vite",
        "build": "vue-tsc --noEmit && vite build",
        "build:native": "vue-tsc --noEmit && VITE_NATIVE_IMPL_DIR=native-plugins vite build",
        "android": "npm run build:native && cap sync android && cap open android",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run --passWithNoTests",
        "ios": "npm run build:native && cap sync ios && cap open ios"
    },
    "dependencies": {
        "@capacitor/app": "^8.1.1",
        "@capacitor/core": "^8.5.2",
        "@luminary-media-converter/player-core": "file:../../player-core",
        "@luminary-media-converter/player-native": "file:..",
        "@luminary-media-converter/player-web": "file:../../player-web",
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@capacitor/android": "^8.5.2",
        "@capacitor/cli": "^8.5.2",
        "@capacitor/ios": "^8.5.2",
        "@vitejs/plugin-vue": "^5.2.0",
        "typescript": "~5.7.0",
        "vite": "^6.0.0",
        "vitest": "^3.0.0",
        "vue-tsc": "^2.2.0"
    }
}
