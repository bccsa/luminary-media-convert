{
    "name": "@luminary-media-converter/player-native",
    "version": "0.0.1",
    "private": true,
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "ios",
        "android",
        "*.podspec"
    ],
    "capacitor": {
        "ios": {
            "src": "ios"
        },
        "android": {
            "src": "android"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.spec.json",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@luminary-media-converter/player-core": "file:../player-core"
    },
    "peerDependencies": {
        "@capacitor/core": "^8.0.0"
    },
    "devDependencies": {
        "@capacitor/core": "^8.5.2",
        "typescript": "~5.7.0",
        "vitest": "^3.0.0"
    }
}
