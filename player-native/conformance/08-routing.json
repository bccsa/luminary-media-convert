{
    "name": "routing: an asset with its content type, the key as 16 bytes, a missing asset, a missing key",
    "fetch": {
        "https://cdn.example.com/s/master.m3u8": "@SIMPLE_MASTER",
        "https://cdn.example.com/s/stream_1080/playlist.m3u8": "@ENCRYPTED_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/stream_720/playlist.m3u8": "@ENCRYPTED_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/stream_480/playlist.m3u8": "@ENCRYPTED_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/audio_hi_128kbps/playlist.m3u8": "@ENCRYPTED_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/audio_lo_64kbps/playlist.m3u8": "@ENCRYPTED_MEDIA_PLAYLIST"
    },
    "steps": [
        {"drive": {"start": {}}},
        {"call": {"method": "getInfo", "result": {"protocolVersion": 1}}},
        {"call": {"method": "reset"}},
        {
            "call": {
                "method": "create",
                "args": {"protocolVersion": 1, "skipBackSeconds": 10, "skipForwardSeconds": 10},
                "result": {"playerId": "$player"}
            }
        },
        {
            "drive": {
                "controller": "load",
                "args": {"masterUrl": "https://cdn.example.com/s/master.m3u8", "keyHex": "@TEST_KEY_HEX"}
            }
        },
        {
            "call": {
                "method": "load",
                "args": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "generation": 1,
                    "masterUri": "luminary://asset/1/3.m3u8",
                    "assets": [
                        {
                            "uri": "luminary://asset/1/1.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXT-X-KEY:METHOD=AES-128,URI=\"luminary://key\",IV=0x00000000000000000000000000000001\n#EXTINF:4.0,\nhttps://cdn.example.com/s/v/0.m4s\n#EXT-X-ENDLIST\n"
                        },
                        {
                            "uri": "luminary://asset/1/2.vtt",
                            "contentType": "text/vtt",
                            "text": "WEBVTT\n\n00:00:00.000 --> 00:00:04.000\nHello\n"
                        },
                        {
                            "uri": "luminary://asset/1/3.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000000,RESOLUTION=854x480\nluminary://asset/1/1.m3u8\n"
                        }
                    ],
                    "keyHex": "000102030405060708090a0b0c0d0e0f",
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [2000, 4000, 8000]
                    }
                },
                "match": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "generation": 1,
                    "masterUri": {"$prefix": "luminary://asset/1/"},
                    "assets": {
                        "$each": {
                            "uri": {"$prefix": "luminary://asset/1/"},
                            "contentType": "application/vnd.apple.mpegurl"
                        }
                    },
                    "keyHex": "000102030405060708090a0b0c0d0e0f",
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [2000, 4000, 8000]
                    }
                }
            }
        },
        {
            "event": {
                "name": "audiotracks-updated",
                "payload": {"playerId": "$player", "loadId": "$load1", "tracks": [], "activeId": null}
            }
        },
        {
            "route": {
                "uri": "luminary://asset/1/3.m3u8",
                "expect": {
                    "contentType": "application/vnd.apple.mpegurl",
                    "text": "#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000000,RESOLUTION=854x480\nluminary://asset/1/1.m3u8\n"
                }
            }
        },
        {
            "route": {
                "uri": "luminary://asset/1/2.vtt",
                "expect": {"contentType": "text/vtt", "text": "WEBVTT\n\n00:00:00.000 --> 00:00:04.000\nHello\n"}
            }
        },
        {
            "route": {"uri": "luminary://key", "expect": {"bytes": 16, "hex": "000102030405060708090a0b0c0d0e0f"}}
        },
        {"route": {"uri": "luminary://asset/1/99.m3u8", "expect": {"error": "not-found"}}},
        {"route": {"uri": "luminary://asset/7/1.m3u8", "expect": {"error": "not-found"}}},
        {
            "note": "A load without a key replaces the old one with none.",
            "only": "native",
            "call": {
                "method": "load",
                "args": {
                    "playerId": "$player",
                    "loadId": "$load2",
                    "generation": 2,
                    "masterUri": "luminary://asset/2/4.m3u8",
                    "assets": [
                        {
                            "uri": "luminary://asset/2/3.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXTINF:4.0,\nhttps://cdn.example.com/s/v/1.m4s\n#EXT-X-ENDLIST\n"
                        },
                        {
                            "uri": "luminary://asset/2/4.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000000,RESOLUTION=854x480\nluminary://asset/2/3.m3u8\n"
                        }
                    ],
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [2000, 4000, 8000]
                    }
                }
            }
        },
        {
            "event": {
                "name": "audiotracks-updated",
                "payload": {"playerId": "$player", "loadId": "$load2", "tracks": [], "activeId": null}
            },
            "only": "native"
        },
        {"route": {"uri": "luminary://key", "expect": {"error": "key-required"}}}
    ]
}
