{
    "name": "create, load and play: the event order and the stamped ids",
    "fetch": {
        "https://cdn.example.com/s/master.m3u8": "@SIMPLE_MASTER",
        "https://cdn.example.com/s/stream_1080/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/stream_720/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/stream_480/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/audio_hi_128kbps/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/audio_lo_64kbps/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST"
    },
    "steps": [
        { "drive": { "start": {} } },
        { "call": { "method": "getInfo", "result": { "protocolVersion": 1 } } },
        { "call": { "method": "reset" } },
        {
            "call": {
                "method": "create",
                "args": { "protocolVersion": 1, "skipBackSeconds": 10, "skipForwardSeconds": 10 },
                "result": { "playerId": "$player" }
            }
        },

        { "drive": { "controller": "load", "args": { "masterUrl": "https://cdn.example.com/s/master.m3u8" } } },
        {
            "call": {
                "method": "load",
                "args": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "generation": 1,
                    "masterUri": "luminary://asset/1/2.m3u8",
                    "assets": [
                        {
                            "uri": "luminary://asset/1/1.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXTINF:4.0,\nhttps://cdn.example.com/s/v/0.m4s\n#EXT-X-ENDLIST\n"
                        },
                        {
                            "uri": "luminary://asset/1/2.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000000,RESOLUTION=854x480\nluminary://asset/1/1.m3u8\n"
                        }
                    ],
                    "recovery": { "escalationWindowMs": 10000, "maxReloadAttempts": 3, "reloadDelaysMs": [2000, 4000, 8000] }
                },
                "match": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "generation": 1,
                    "masterUri": { "$prefix": "luminary://asset/1/" },
                    "assets": {
                        "$length": 6,
                        "$each": { "uri": { "$prefix": "luminary://asset/1/" }, "contentType": "application/vnd.apple.mpegurl" }
                    },
                    "keyHex": { "$absent": true },
                    "recovery": { "escalationWindowMs": 10000, "maxReloadAttempts": 3, "reloadDelaysMs": [2000, 4000, 8000] }
                }
            }
        },
        {
            "note": "The empty list every load starts with.",
            "event": { "name": "audiotracks-updated", "payload": { "playerId": "$player", "loadId": "$load1", "tracks": [], "activeId": null } }
        },

        { "engine": { "signal": "readyToPlay", "duration": 120 } },
        { "event": { "name": "durationchange", "payload": { "playerId": "$player", "loadId": "$load1", "duration": 120 } } },
        { "event": { "name": "loadedmetadata", "payload": { "playerId": "$player", "loadId": "$load1", "duration": 120 } } },
        { "expectAdapter": { "getDuration": 120, "getCurrentTime": 0 } },

        { "drive": { "controller": "play" } },
        { "call": { "method": "play", "args": { "playerId": "$player" } } },
        { "expectEngine": [{ "method": "load", "masterUri": "luminary://asset/1/2.m3u8" }, { "method": "play" }] },
        { "engine": { "signal": "playing" } },
        { "event": { "name": "playing", "payload": { "playerId": "$player", "loadId": "$load1" } } },
        { "advanceClock": 0.5 },
        { "event": { "name": "timeupdate", "payload": { "playerId": "$player", "loadId": "$load1", "currentTime": 0.25 } } },
        { "event": { "name": "timeupdate", "payload": { "playerId": "$player", "loadId": "$load1", "currentTime": 0.5 } } },
        { "expectState": { "playing": true, "currentTime": 0.5, "duration": 120 } }
    ]
}
