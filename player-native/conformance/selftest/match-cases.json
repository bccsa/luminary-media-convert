{
    "description": "The ref and matcher rules every runner ports. Each case runs its ops in order against one fresh set of refs. An assert op without `actual` asserts against a missing value.",
    "cases": [
        { "name": "subset: extra keys are fine", "ops": [{ "assert": { "expected": { "a": 1 }, "actual": { "a": 1, "b": 2 } }, "ok": true }] },
        { "name": "subset: a missing key fails", "ops": [{ "assert": { "expected": { "a": 1 }, "actual": { "b": 2 } }, "ok": false }] },
        { "name": "numbers compare by value", "ops": [{ "assert": { "expected": 1, "actual": 1.0 }, "ok": true }] },
        { "name": "null is not absent", "ops": [{ "assert": { "expected": { "a": null }, "actual": {} }, "ok": false }] },
        { "name": "null matches null", "ops": [{ "assert": { "expected": { "a": null }, "actual": { "a": null } }, "ok": true }] },
        { "name": "a string is not a number", "ops": [{ "assert": { "expected": "1", "actual": 1 }, "ok": false }] },
        { "name": "false is not 0", "ops": [{ "assert": { "expected": false, "actual": 0 }, "ok": false }] },
        { "name": "arrays match element-wise", "ops": [{ "assert": { "expected": [{ "a": 1 }, 2], "actual": [{ "a": 1, "z": 0 }, 2] }, "ok": true }] },
        { "name": "arrays must be the same length", "ops": [{ "assert": { "expected": [1], "actual": [1, 2] }, "ok": false }] },
        { "name": "a ref binds on first use", "ops": [
            { "assert": { "expected": { "id": "$a" }, "actual": { "id": "x" } }, "ok": true },
            { "assert": { "expected": "$a", "actual": "x" }, "ok": true },
            { "assert": { "expected": "$a", "actual": "y" }, "ok": false }
        ] },
        { "name": "two refs never hold the same value", "ops": [
            { "assert": { "expected": "$a", "actual": "x" }, "ok": true },
            { "assert": { "expected": "$b", "actual": "x" }, "ok": false }
        ] },
        { "name": "an unbound ref cannot match a missing value", "ops": [{ "assert": { "expected": { "id": "$a" }, "actual": {} }, "ok": false }] },
        { "name": "issuing an unbound ref mints its name", "ops": [
            { "issue": { "id": "$load1" }, "result": { "id": "load1" } },
            { "assert": { "expected": "$load1", "actual": "load1" }, "ok": true }
        ] },
        { "name": "issuing a bound ref sends its value", "ops": [
            { "assert": { "expected": "$p", "actual": "player-7" }, "ok": true },
            { "issue": ["$p"], "result": ["player-7"] }
        ] },
        { "name": "issuing $absent drops the key", "ops": [{ "issue": { "a": 1, "b": { "$absent": true } }, "result": { "a": 1 } }] },
        { "name": "any other matcher cannot be issued", "ops": [{ "issue": { "a": { "$any": true } }, "error": true }] },
        { "name": "$absent", "ops": [
            { "assert": { "expected": { "k": { "$absent": true } }, "actual": {} }, "ok": true },
            { "assert": { "expected": { "k": { "$absent": true } }, "actual": { "k": null } }, "ok": false }
        ] },
        { "name": "$any", "ops": [
            { "assert": { "expected": { "$any": true }, "actual": null }, "ok": true },
            { "assert": { "expected": { "$any": true } }, "ok": false }
        ] },
        { "name": "$prefix", "ops": [
            { "assert": { "expected": { "$prefix": "luminary://asset/1/" }, "actual": "luminary://asset/1/3.m3u8" }, "ok": true },
            { "assert": { "expected": { "$prefix": "luminary://asset/1/" }, "actual": "luminary://asset/2/3.m3u8" }, "ok": false },
            { "assert": { "expected": { "$prefix": "1" }, "actual": 1 }, "ok": false }
        ] },
        { "name": "$length on arrays and strings", "ops": [
            { "assert": { "expected": { "$length": 2 }, "actual": [0, 0] }, "ok": true },
            { "assert": { "expected": { "$length": 3 }, "actual": "abc" }, "ok": true },
            { "assert": { "expected": { "$length": 1 }, "actual": [] }, "ok": false }
        ] },
        { "name": "$each, combined with $length", "ops": [
            { "assert": { "expected": { "$length": 2, "$each": { "t": "a" } }, "actual": [{ "t": "a" }, { "t": "a", "u": 1 }] }, "ok": true },
            { "assert": { "expected": { "$each": { "t": "a" } }, "actual": [{ "t": "a" }, { "t": "b" }] }, "ok": false },
            { "assert": { "expected": { "$each": { "t": "a" } }, "actual": [] }, "ok": true }
        ] },
        { "name": "$contains", "ops": [
            { "assert": { "expected": { "$contains": { "method": "pause" } }, "actual": [{ "method": "load" }, { "method": "pause" }] }, "ok": true },
            { "assert": { "expected": { "$contains": { "method": "pause" } }, "actual": [{ "method": "load" }] }, "ok": false }
        ] },
        { "name": "$not", "ops": [
            { "assert": { "expected": { "$not": { "$contains": { "method": "pause" } } }, "actual": [{ "method": "load" }] }, "ok": true },
            { "assert": { "expected": { "$not": 1 }, "actual": 1 }, "ok": false }
        ] },
        { "name": "an attempt inside $contains never binds", "ops": [
            { "assert": { "expected": { "$contains": "$a" }, "actual": ["x"] }, "ok": false }
        ] },
        { "name": "an unknown matcher fails", "ops": [{ "assert": { "expected": { "$regex": "." }, "actual": "x" }, "ok": false }] }
    ]
}
