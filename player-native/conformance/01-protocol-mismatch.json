{
    "name": "a native side on another protocol version is refused before anything starts",
    "steps": [
        {"drive": {"start": {}, "rejects": "protocol-mismatch"}},
        {
            "call": {"method": "getInfo", "result": {"protocolVersion": 2}},
            "only": "ts",
            "note": "Native reports a version this side does not speak: no reset, no create."
        },
        {"expectNoCalls": true},
        {
            "call": {"method": "getInfo", "result": {"protocolVersion": 1, "capabilities": {"maxPlayers": 1}}},
            "only": "native"
        },
        {
            "call": {
                "method": "create",
                "args": {"protocolVersion": 2, "skipBackSeconds": 10, "skipForwardSeconds": 10},
                "rejects": "protocol-mismatch"
            },
            "only": "native"
        },
        {"expectNoEvents": true}
    ]
}
