{
    "name": "exitFullscreen leaves a video shown in the page playing, and pauses one that is not",
    "capabilities": {
        "inlineVideo": true
    },
    "steps": [
        {
            "drive": {
                "start": {}
            }
        },
        {
            "call": {
                "method": "getInfo",
                "result": {
                    "protocolVersion": 1
                }
            }
        },
        {
            "call": {
                "method": "reset"
            }
        },
        {
            "call": {
                "method": "create",
                "args": {
                    "protocolVersion": 1,
                    "skipBackSeconds": 10,
                    "skipForwardSeconds": 10
                },
                "result": {
                    "playerId": "$player"
                }
            }
        },
        {
            "call": {
                "method": "setInlineFrame",
                "args": {
                    "playerId": "$player",
                    "frame": {
                        "x": 0,
                        "y": 72,
                        "width": 390,
                        "height": 219
                    }
                }
            },
            "only": "native"
        },
        {
            "call": {
                "method": "exitFullscreen",
                "args": {
                    "playerId": "$player"
                }
            },
            "only": "native"
        },
        {
            "expectEngine": [
                {
                    "method": "setInlineFrame"
                },
                {
                    "method": "exitFullscreen"
                }
            ],
            "only": "native"
        },
        {
            "call": {
                "method": "setInlineFrame",
                "args": {
                    "playerId": "$player"
                }
            },
            "only": "native"
        },
        {
            "call": {
                "method": "exitFullscreen",
                "args": {
                    "playerId": "$player"
                }
            },
            "only": "native"
        },
        {
            "expectEngine": [
                {
                    "method": "setInlineFrame"
                },
                {
                    "method": "exitFullscreen"
                },
                {
                    "method": "pause"
                }
            ],
            "only": "native"
        }
    ]
}
