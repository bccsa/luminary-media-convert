{
    "name": "a language or speed the viewer picks in native UI reaches the controller; answers to JavaScript's own calls do not come back as choices",
    "fetch": {
        "https://cdn.example.com/s/master.m3u8": "@SIMPLE_MASTER",
        "https://cdn.example.com/s/stream_1080/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/stream_720/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/stream_480/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/audio_hi_128kbps/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/audio_lo_64kbps/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST"
    },
    "steps": [
        {
            "drive": {
                "start": {}
            }
        },
        {
            "call": {
                "method": "getInfo",
                "result": {
                    "protocolVersion": 1
                }
            }
        },
        {
            "call": {
                "method": "reset"
            }
        },
        {
            "call": {
                "method": "create",
                "args": {
                    "protocolVersion": 1,
                    "skipBackSeconds": 10,
                    "skipForwardSeconds": 10
                },
                "result": {
                    "playerId": "$player"
                }
            }
        },
        {
            "drive": {
                "controller": "load",
                "args": {
                    "masterUrl": "https://cdn.example.com/s/master.m3u8"
                }
            }
        },
        {
            "call": {
                "method": "load",
                "args": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "generation": 1,
                    "masterUri": "luminary://asset/1/2.m3u8",
                    "assets": [
                        {
                            "uri": "luminary://asset/1/1.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXTINF:4.0,\nhttps://cdn.example.com/s/v/0.m4s\n#EXT-X-ENDLIST\n"
                        },
                        {
                            "uri": "luminary://asset/1/2.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000000,RESOLUTION=854x480\nluminary://asset/1/1.m3u8\n"
                        }
                    ],
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [
                            2000,
                            4000,
                            8000
                        ]
                    }
                },
                "match": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "generation": 1,
                    "masterUri": {
                        "$prefix": "luminary://asset/1/"
                    },
                    "assets": {
                        "$each": {
                            "uri": {
                                "$prefix": "luminary://asset/1/"
                            },
                            "contentType": "application/vnd.apple.mpegurl"
                        }
                    },
                    "keyHex": {
                        "$absent": true
                    },
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [
                            2000,
                            4000,
                            8000
                        ]
                    }
                }
            }
        },
        {
            "event": {
                "name": "audiotracks-updated",
                "payload": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "tracks": [],
                    "activeId": null
                }
            }
        },
        {
            "engine": {
                "signal": "tracks",
                "tracks": [
                    {
                        "id": "en",
                        "lang": "en",
                        "label": "English"
                    },
                    {
                        "id": "fr",
                        "lang": "fr",
                        "label": "Français"
                    }
                ],
                "activeId": "en"
            }
        },
        {
            "event": {
                "name": "audiotracks-updated",
                "payload": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "tracks": [
                        {
                            "id": "en",
                            "lang": "en",
                            "label": "English"
                        },
                        {
                            "id": "fr",
                            "lang": "fr",
                            "label": "Français"
                        }
                    ],
                    "activeId": "en"
                }
            }
        },
        {
            "expectState": {
                "activeAudioTrackId": "en",
                "playbackRate": 1
            }
        },
        {
            "engine": {
                "signal": "tracks",
                "tracks": [
                    {
                        "id": "en",
                        "lang": "en",
                        "label": "English"
                    },
                    {
                        "id": "fr",
                        "lang": "fr",
                        "label": "Français"
                    }
                ],
                "activeId": "fr"
            },
            "note": "The viewer picks French in native full-screen."
        },
        {
            "event": {
                "name": "audiotracks-updated",
                "payload": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "tracks": [
                        {
                            "id": "en",
                            "lang": "en",
                            "label": "English"
                        },
                        {
                            "id": "fr",
                            "lang": "fr",
                            "label": "Français"
                        }
                    ],
                    "activeId": "fr"
                }
            }
        },
        {
            "expectState": {
                "activeAudioTrackId": "fr"
            },
            "note": "The controller adopts it, so the next attach hands French back."
        },
        {
            "expectNoCalls": true,
            "note": "Native already plays French: nothing is sent back."
        },
        {
            "engine": {
                "signal": "rate",
                "rate": 1.5
            },
            "note": "The viewer picks 1.5x."
        },
        {
            "event": {
                "name": "ratechange",
                "payload": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "rate": 1.5
                }
            }
        },
        {
            "expectState": {
                "playbackRate": 1.5
            }
        },
        {
            "expectNoCalls": true
        },
        {
            "engine": {
                "signal": "rate",
                "rate": 1.5
            },
            "note": "No change, no event."
        },
        {
            "expectNoEvents": true
        },
        {
            "drive": {
                "controller": "setPlaybackRate",
                "args": [
                    2
                ]
            }
        },
        {
            "call": {
                "method": "setRate",
                "args": {
                    "playerId": "$player",
                    "rate": 2
                }
            }
        },
        {
            "drive": {
                "controller": "setPlaybackRate",
                "args": [
                    1.25
                ]
            }
        },
        {
            "call": {
                "method": "setRate",
                "args": {
                    "playerId": "$player",
                    "rate": 1.25
                }
            }
        },
        {
            "engine": {
                "signal": "rate",
                "rate": 2
            }
        },
        {
            "event": {
                "name": "ratechange",
                "payload": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "rate": 2
                }
            }
        },
        {
            "engine": {
                "signal": "rate",
                "rate": 1.25
            }
        },
        {
            "event": {
                "name": "ratechange",
                "payload": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "rate": 1.25
                }
            }
        },
        {
            "expectState": {
                "playbackRate": 1.25
            },
            "note": "Answers to JavaScript's own calls, the first overtaken by the second: neither is taken for a viewer's choice."
        },
        {
            "expectNoCalls": true
        },
        {
            "drive": {
                "controller": "setAudioTrack",
                "args": [
                    "en"
                ]
            }
        },
        {
            "call": {
                "method": "setAudioTrack",
                "args": {
                    "playerId": "$player",
                    "id": "en"
                }
            }
        },
        {
            "engine": {
                "signal": "tracks",
                "tracks": [
                    {
                        "id": "en",
                        "lang": "en",
                        "label": "English"
                    },
                    {
                        "id": "fr",
                        "lang": "fr",
                        "label": "Français"
                    }
                ],
                "activeId": "en"
            }
        },
        {
            "event": {
                "name": "audiotracks-updated",
                "payload": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "tracks": [
                        {
                            "id": "en",
                            "lang": "en",
                            "label": "English"
                        },
                        {
                            "id": "fr",
                            "lang": "fr",
                            "label": "Français"
                        }
                    ],
                    "activeId": "en"
                }
            }
        },
        {
            "expectState": {
                "activeAudioTrackId": "en"
            }
        },
        {
            "expectNoCalls": true
        },
        {
            "expectEngine": [
                {
                    "method": "load",
                    "masterUri": "luminary://asset/1/2.m3u8"
                },
                {
                    "method": "setRate",
                    "rate": 2
                },
                {
                    "method": "setRate",
                    "rate": 1.25
                },
                {
                    "method": "setAudioTrack",
                    "id": "en"
                }
            ]
        },
        {
            "expectNoEvents": true
        }
    ]
}
