{
    "name": "exitFullscreen pauses, except for audio-only",
    "steps": [
        {"drive": {"start": {}}},
        {"call": {"method": "getInfo", "result": {"protocolVersion": 1}}},
        {"call": {"method": "reset"}},
        {
            "call": {
                "method": "create",
                "args": {"protocolVersion": 1, "skipBackSeconds": 10, "skipForwardSeconds": 10},
                "result": {"playerId": "$player"}
            }
        },
        {
            "call": {
                "method": "load",
                "args": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "generation": 1,
                    "masterUri": "luminary://asset/1/2.m3u8",
                    "assets": [
                        {
                            "uri": "luminary://asset/1/1.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXTINF:4.0,\nhttps://cdn.example.com/s/v/0.m4s\n#EXT-X-ENDLIST\n"
                        },
                        {
                            "uri": "luminary://asset/1/2.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000000,RESOLUTION=854x480\nluminary://asset/1/1.m3u8\n"
                        }
                    ],
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [2000, 4000, 8000]
                    }
                }
            },
            "only": "native"
        },
        {
            "event": {
                "name": "audiotracks-updated",
                "payload": {"playerId": "$player", "loadId": "$load1", "tracks": [], "activeId": null}
            },
            "only": "native"
        },
        {"engine": {"signal": "readyToPlay", "duration": 120, "hasVideo": true}},
        {
            "event": {
                "name": "durationchange",
                "payload": {"playerId": "$player", "loadId": "$load1", "duration": 120}
            },
            "only": "native"
        },
        {
            "event": {
                "name": "loadedmetadata",
                "payload": {"playerId": "$player", "loadId": "$load1", "duration": 120}
            },
            "only": "native"
        },
        {"call": {"method": "enterFullscreen", "args": {"playerId": "$player"}}, "only": "native"},
        {"call": {"method": "exitFullscreen", "args": {"playerId": "$player"}}, "only": "native"},
        {
            "expectEngine": {"$length": 4, "$contains": {"method": "pause"}},
            "note": "load, enterFullscreen, exitFullscreen and pause; the last two in either order."
        },
        {
            "call": {
                "method": "load",
                "args": {
                    "playerId": "$player",
                    "loadId": "$load2",
                    "generation": 2,
                    "masterUri": "luminary://asset/2/4.m3u8",
                    "assets": [
                        {
                            "uri": "luminary://asset/2/3.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXTINF:4.0,\nhttps://cdn.example.com/s/a/0.m4s\n#EXT-X-ENDLIST\n"
                        },
                        {
                            "uri": "luminary://asset/2/4.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=128000,CODECS=\"mp4a.40.2\"\nluminary://asset/2/3.m3u8\n"
                        }
                    ],
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [2000, 4000, 8000]
                    }
                }
            },
            "only": "native"
        },
        {
            "event": {
                "name": "audiotracks-updated",
                "payload": {"playerId": "$player", "loadId": "$load2", "tracks": [], "activeId": null}
            },
            "only": "native"
        },
        {"engine": {"signal": "readyToPlay", "duration": 60, "hasVideo": false}},
        {
            "event": {"name": "durationchange", "payload": {"playerId": "$player", "loadId": "$load2", "duration": 60}},
            "only": "native"
        },
        {
            "event": {"name": "loadedmetadata", "payload": {"playerId": "$player", "loadId": "$load2", "duration": 60}},
            "only": "native"
        },
        {"call": {"method": "enterFullscreen", "args": {"playerId": "$player"}}, "only": "native"},
        {"call": {"method": "exitFullscreen", "args": {"playerId": "$player"}}, "only": "native"},
        {
            "expectEngine": [
                {"method": "load", "masterUri": "luminary://asset/2/4.m3u8"},
                {"method": "enterFullscreen"},
                {"method": "exitFullscreen"}
            ],
            "note": "Audio keeps playing when the full-screen view goes away."
        },
        {"expectNoEvents": true}
    ]
}
