{
    "name": "an angle switch in the same generation sends only what is new, and evicts nothing",
    "fetch": {
        "https://cdn.example.com/s/master.m3u8": "@MULTI_ANGLE_MASTER",
        "https://cdn.example.com/s/angle0_1080/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/angle0_720/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/angle1_1080/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/audio_128kbps/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/subs_en/playlist.m3u8": "@SUBTITLE_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/subs_en/en_0.vtt": "@CHAPTERS_VTT"
    },
    "steps": [
        {"drive": {"start": {}}},
        {"call": {"method": "getInfo", "result": {"protocolVersion": 1}}},
        {"call": {"method": "reset"}},
        {
            "call": {
                "method": "create",
                "args": {"protocolVersion": 1, "skipBackSeconds": 10, "skipForwardSeconds": 10},
                "result": {"playerId": "$player"}
            }
        },
        {"drive": {"controller": "load", "args": {"masterUrl": "https://cdn.example.com/s/master.m3u8"}}},
        {
            "call": {
                "method": "load",
                "args": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "generation": 1,
                    "masterUri": "luminary://asset/1/2.m3u8",
                    "assets": [
                        {
                            "uri": "luminary://asset/1/1.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXTINF:4.0,\nhttps://cdn.example.com/s/a0/0.m4s\n#EXT-X-ENDLIST\n"
                        },
                        {
                            "uri": "luminary://asset/1/2.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000000,RESOLUTION=854x480\nluminary://asset/1/1.m3u8\n"
                        }
                    ],
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [2000, 4000, 8000]
                    }
                },
                "match": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "generation": 1,
                    "masterUri": {"$prefix": "luminary://asset/1/"},
                    "assets": {
                        "$each": {
                            "uri": {"$prefix": "luminary://asset/1/"},
                            "contentType": "application/vnd.apple.mpegurl"
                        }
                    },
                    "keyHex": {"$absent": true},
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [2000, 4000, 8000]
                    }
                }
            }
        },
        {
            "event": {
                "name": "audiotracks-updated",
                "payload": {"playerId": "$player", "loadId": "$load1", "tracks": [], "activeId": null}
            }
        },
        {"drive": {"controller": "setAngle", "args": ["angle_1"]}},
        {
            "call": {
                "method": "load",
                "args": {
                    "playerId": "$player",
                    "loadId": "$load2",
                    "generation": 1,
                    "masterUri": "luminary://asset/1/4.m3u8",
                    "assets": [
                        {
                            "uri": "luminary://asset/1/3.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXTINF:4.0,\nhttps://cdn.example.com/s/a1/0.m4s\n#EXT-X-ENDLIST\n"
                        },
                        {
                            "uri": "luminary://asset/1/4.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000000,RESOLUTION=854x480\nluminary://asset/1/3.m3u8\n"
                        }
                    ],
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [2000, 4000, 8000]
                    }
                },
                "match": {
                    "playerId": "$player",
                    "loadId": "$load2",
                    "generation": 1,
                    "masterUri": {"$prefix": "luminary://asset/1/"},
                    "assets": {
                        "$each": {
                            "uri": {"$prefix": "luminary://asset/1/"},
                            "contentType": "application/vnd.apple.mpegurl"
                        },
                        "$length": 2
                    },
                    "keyHex": {"$absent": true},
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [2000, 4000, 8000]
                    }
                }
            },
            "note": "A new master and the one playlist angle_1 adds."
        },
        {
            "event": {
                "name": "audiotracks-updated",
                "payload": {"playerId": "$player", "loadId": "$load2", "tracks": [], "activeId": null}
            }
        },
        {"drive": {"controller": "setAngle", "args": ["angle_0"]}},
        {
            "call": {
                "method": "load",
                "args": {
                    "playerId": "$player",
                    "loadId": "$load3",
                    "generation": 1,
                    "masterUri": "luminary://asset/1/5.m3u8",
                    "assets": [
                        {
                            "uri": "luminary://asset/1/5.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000000,RESOLUTION=854x480\nluminary://asset/1/1.m3u8\n"
                        }
                    ],
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [2000, 4000, 8000]
                    }
                },
                "match": {
                    "playerId": "$player",
                    "loadId": "$load3",
                    "generation": 1,
                    "masterUri": {"$prefix": "luminary://asset/1/"},
                    "assets": {
                        "$each": {
                            "uri": {"$prefix": "luminary://asset/1/"},
                            "contentType": "application/vnd.apple.mpegurl"
                        },
                        "$length": 1
                    },
                    "keyHex": {"$absent": true},
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [2000, 4000, 8000]
                    }
                }
            },
            "note": "Back to an angle already served: only the master is new."
        },
        {
            "event": {
                "name": "audiotracks-updated",
                "payload": {"playerId": "$player", "loadId": "$load3", "tracks": [], "activeId": null}
            }
        },
        {
            "route": {
                "uri": "luminary://asset/1/1.m3u8",
                "expect": {
                    "contentType": "application/vnd.apple.mpegurl",
                    "text": "#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXTINF:4.0,\nhttps://cdn.example.com/s/a0/0.m4s\n#EXT-X-ENDLIST\n"
                }
            }
        },
        {
            "route": {
                "uri": "luminary://asset/1/2.m3u8",
                "expect": {
                    "contentType": "application/vnd.apple.mpegurl",
                    "text": "#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000000,RESOLUTION=854x480\nluminary://asset/1/1.m3u8\n"
                }
            }
        },
        {
            "route": {
                "uri": "luminary://asset/1/3.m3u8",
                "expect": {
                    "contentType": "application/vnd.apple.mpegurl",
                    "text": "#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXTINF:4.0,\nhttps://cdn.example.com/s/a1/0.m4s\n#EXT-X-ENDLIST\n"
                }
            }
        },
        {
            "route": {"uri": "luminary://asset/1/5.m3u8", "expect": {"contentType": "application/vnd.apple.mpegurl"}}
        },
        {
            "expectEngine": [
                {"method": "load", "masterUri": "luminary://asset/1/2.m3u8"},
                {"method": "load", "masterUri": "luminary://asset/1/4.m3u8"},
                {"method": "load", "masterUri": "luminary://asset/1/5.m3u8"}
            ]
        }
    ]
}
