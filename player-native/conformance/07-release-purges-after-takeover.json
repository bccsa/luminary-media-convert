{
    "name": "releaseAssets purges a generation only once the next load has taken over",
    "fetch": {
        "https://cdn.example.com/s/master.m3u8": "@SIMPLE_MASTER",
        "https://cdn.example.com/s/stream_1080/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/stream_720/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/stream_480/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/audio_hi_128kbps/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST",
        "https://cdn.example.com/s/audio_lo_64kbps/playlist.m3u8": "@PLAIN_MEDIA_PLAYLIST"
    },
    "steps": [
        {"drive": {"start": {}}},
        {"call": {"method": "getInfo", "result": {"protocolVersion": 1}}},
        {"call": {"method": "reset"}},
        {
            "call": {
                "method": "create",
                "args": {"protocolVersion": 1, "skipBackSeconds": 10, "skipForwardSeconds": 10},
                "result": {"playerId": "$player"}
            }
        },
        {"drive": {"controller": "load", "args": {"masterUrl": "https://cdn.example.com/s/master.m3u8"}}},
        {
            "call": {
                "method": "load",
                "args": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "generation": 1,
                    "masterUri": "luminary://asset/1/2.m3u8",
                    "assets": [
                        {
                            "uri": "luminary://asset/1/1.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXTINF:4.0,\nhttps://cdn.example.com/s/v/0.m4s\n#EXT-X-ENDLIST\n"
                        },
                        {
                            "uri": "luminary://asset/1/2.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000000,RESOLUTION=854x480\nluminary://asset/1/1.m3u8\n"
                        }
                    ],
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [2000, 4000, 8000]
                    }
                },
                "match": {
                    "playerId": "$player",
                    "loadId": "$load1",
                    "generation": 1,
                    "masterUri": {"$prefix": "luminary://asset/1/"},
                    "assets": {
                        "$each": {
                            "uri": {"$prefix": "luminary://asset/1/"},
                            "contentType": "application/vnd.apple.mpegurl"
                        }
                    },
                    "keyHex": {"$absent": true},
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [2000, 4000, 8000]
                    }
                }
            }
        },
        {
            "event": {
                "name": "audiotracks-updated",
                "payload": {"playerId": "$player", "loadId": "$load1", "tracks": [], "activeId": null}
            }
        },
        {"drive": {"controller": "load", "args": {"masterUrl": "https://cdn.example.com/s/master.m3u8"}}},
        {"call": {"method": "releaseAssets", "args": {"playerId": "$player", "generation": 1}}},
        {
            "note": "Released, but the engine still plays from it.",
            "route": {
                "uri": "luminary://asset/1/1.m3u8",
                "expect": {
                    "contentType": "application/vnd.apple.mpegurl",
                    "text": "#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXTINF:4.0,\nhttps://cdn.example.com/s/v/0.m4s\n#EXT-X-ENDLIST\n"
                }
            }
        },
        {
            "call": {
                "method": "load",
                "args": {
                    "playerId": "$player",
                    "loadId": "$load2",
                    "generation": 2,
                    "masterUri": "luminary://asset/2/4.m3u8",
                    "assets": [
                        {
                            "uri": "luminary://asset/2/3.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXTINF:4.0,\nhttps://cdn.example.com/s/v/1.m4s\n#EXT-X-ENDLIST\n"
                        },
                        {
                            "uri": "luminary://asset/2/4.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000000,RESOLUTION=854x480\nluminary://asset/2/3.m3u8\n"
                        }
                    ],
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [2000, 4000, 8000]
                    }
                },
                "match": {
                    "playerId": "$player",
                    "loadId": "$load2",
                    "generation": 2,
                    "masterUri": {"$prefix": "luminary://asset/2/"},
                    "assets": {
                        "$each": {
                            "uri": {"$prefix": "luminary://asset/2/"},
                            "contentType": "application/vnd.apple.mpegurl"
                        }
                    },
                    "keyHex": {"$absent": true},
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [2000, 4000, 8000]
                    }
                }
            }
        },
        {
            "event": {
                "name": "audiotracks-updated",
                "payload": {"playerId": "$player", "loadId": "$load2", "tracks": [], "activeId": null}
            }
        },
        {"route": {"uri": "luminary://asset/1/1.m3u8", "expect": {"error": "not-found"}}},
        {"route": {"uri": "luminary://asset/1/2.m3u8", "expect": {"error": "not-found"}}},
        {
            "route": {
                "uri": "luminary://asset/2/3.m3u8",
                "expect": {
                    "contentType": "application/vnd.apple.mpegurl",
                    "text": "#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXTINF:4.0,\nhttps://cdn.example.com/s/v/1.m4s\n#EXT-X-ENDLIST\n"
                }
            }
        },
        {
            "call": {
                "method": "load",
                "args": {
                    "playerId": "$player",
                    "loadId": "$late",
                    "generation": 1,
                    "masterUri": "luminary://asset/1/2.m3u8",
                    "assets": [
                        {
                            "uri": "luminary://asset/1/1.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXTINF:4.0,\nhttps://cdn.example.com/s/v/0.m4s\n#EXT-X-ENDLIST\n"
                        },
                        {
                            "uri": "luminary://asset/1/2.m3u8",
                            "contentType": "application/vnd.apple.mpegurl",
                            "text": "#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000000,RESOLUTION=854x480\nluminary://asset/1/1.m3u8\n"
                        }
                    ],
                    "recovery": {
                        "escalationWindowMs": 10000,
                        "maxReloadAttempts": 3,
                        "reloadDelaysMs": [2000, 4000, 8000]
                    }
                },
                "rejects": "stale-generation"
            },
            "only": "native"
        },
        {"expectNoEvents": true},
        {
            "expectEngine": [
                {"method": "load", "masterUri": "luminary://asset/1/2.m3u8"},
                {"method": "load", "masterUri": "luminary://asset/2/4.m3u8"}
            ]
        }
    ]
}
