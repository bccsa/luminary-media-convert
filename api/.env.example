# API token (required) — accepted on the X-API-Key header for every endpoint
LOCAL_API_TOKEN=change-me-to-a-random-secret

# API server port
PORT=3000

# Browser origins allowed to reach this instance, comma-separated. A CMS
# calling the local encoder must be listed here (or approved at runtime by the
# host app). Requests with no Origin — curl, the desktop app itself — are
# accepted from this machine regardless.
# CMS_ALLOWED_ORIGINS=https://cms.example.com,http://localhost:5199

# Working directory for temporary encoding files (default: os.tmpdir())
# WORK_DIR=/tmp/luminary

# FFmpeg timeout in milliseconds (default: none)
# FFMPEG_TIMEOUT_MS=3600000

# FFmpeg thread count (default: auto)
# FFMPEG_THREADS=4

# Max upload size in bytes (default: 10737418240 / 10 GB)
# MAX_UPLOAD_SIZE=10737418240

# Number of parallel file uploads to S3 (default: 10)
# S3_UPLOAD_CONCURRENCY=10

# Finished sessions are discarded at startup rather than on a clock, so there
# is no maximum-age setting for them.

# When the abandoned-session sweep runs. Default hourly.
SESSION_CLEANUP_CRON=0 * * * *

# How long a session may sit idle before it is treated as abandoned and its
# upload removed. Covers sessions that never finished — created, uploading, or
# uploaded-but-never-encoded — which nothing else bounds. Judged on the last
# sign of life, not on age, so a slow upload is not swept mid-transfer.
# Default 6.
SESSION_ABANDONED_MAX_AGE_HOURS=6

# Free space held back on the work volume when accepting or continuing an
# upload, so a transfer cannot fill the disk out from under a running encode.
# Default 2 GB.
DISK_RESERVE_BYTES=2147483648
