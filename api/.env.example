# Master API key (required) — superkey for all endpoints and API key management
MASTER_API_KEY=change-me-to-a-random-secret

# API server port
PORT=3000

# CORS origin (default: * — all origins allowed)
# Set to a specific origin to restrict browser access
# CORS_ORIGIN=https://myapp.example.com

# Seed for deterministic HLS encryption key derivation
HLS_ENCRYPTION_SEED=change-me-to-a-random-secret

# Working directory for temporary encoding files (default: os.tmpdir())
# WORK_DIR=/tmp/luminary

# FFmpeg timeout in milliseconds (default: none)
# FFMPEG_TIMEOUT_MS=3600000

# FFmpeg thread count (default: auto)
# FFMPEG_THREADS=4

# Max upload size in bytes (default: 10737418240 / 10 GB)
# MAX_UPLOAD_SIZE=10737418240

# Number of parallel file uploads to S3 (default: 10)
# S3_UPLOAD_CONCURRENCY=10

# Override path to the tusd binary (default: auto-detected)
# TUSD_BINARY_PATH=/usr/local/bin/tusd

# Key validation webhook (optional) — validates API keys via an external service
# Returns metadata (userId, webhookUrl, etc.) on valid keys
# KEY_VALIDATION_WEBHOOK_URL=https://example.com/validate-key
# KEY_VALIDATION_WEBHOOK_TIMEOUT_MS=5000
# KEY_VALIDATION_CACHE_TTL_MS=60000

# Authorization webhook (optional) — called before session creation and encode start
# Per-key authorizationUrl takes precedence over this global setting
# AUTHORIZATION_WEBHOOK_URL=https://example.com/authorize
# AUTHORIZATION_WEBHOOK_TIMEOUT_MS=5000
# AUTHORIZATION_WEBHOOK_FAIL_MODE=open

# How long completed and failed sessions are kept before their working
# directory — including the uploaded source — is removed. Default 24.
SESSION_MAX_AGE_HOURS=24

# When the sweep runs. Default hourly.
SESSION_CLEANUP_CRON=0 * * * *

# How long a session may sit idle before it is treated as abandoned and its
# upload removed. Covers sessions that never finished — created, uploading, or
# uploaded-but-never-encoded — which nothing else bounds. Judged on the last
# sign of life, not on age, so a slow upload is not swept mid-transfer.
# Shorter than the finished-session window on purpose. Default 6.
SESSION_ABANDONED_MAX_AGE_HOURS=6

# Free space held back on the work volume when accepting or continuing an
# upload, so a transfer cannot fill the disk out from under a running encode.
# Default 2 GB.
DISK_RESERVE_BYTES=2147483648
