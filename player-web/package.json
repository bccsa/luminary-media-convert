{
    "name": "@luminary-media-converter/player-web",
    "version": "0.0.1",
    "private": true,
    "description": "The Luminary web player: player-core playback on Video.js 10 (hls.js), with the Luminary app's control layout.",
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
        "dev": "concurrently -k -n js,dts -c blue,gray \"vite build --watch\" \"vue-tsc --declaration --emitDeclarationOnly --outDir dist --watch --preserveWatchOutput\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "demo": "vite --config vite.demo.config.ts",
        "skin:css": "node scripts/build-skin-css.mjs",
        "prebuild": "npm run skin:css",
        "predemo": "npm run skin:css",
        "predev": "npm run skin:css",
        "build:lib": "vite build",
        "prebuild:lib": "npm run skin:css",
        "test:e2e": "playwright test",
        "fixtures": "node e2e/fixtures/build.mjs"
    },
    "dependencies": {
        "@luminary-media-converter/player-core": "file:../player-core",
        "@videojs/hlsjs-video": "10.0.1",
        "@videojs/html": "10.0.1"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@vitejs/plugin-vue": "^5.2.0",
        "@vue/test-utils": "^2.4.0",
        "jsdom": "^26.0.0",
        "purgecss": "^8.0.0",
        "typescript": "~5.7.0",
        "vite": "^6.0.0",
        "vite-plugin-css-injected-by-js": "^3.5.0",
        "vitest": "^3.0.0",
        "vue": "^3.5.0",
        "vue-tsc": "^2.2.0"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "**/*.css",
        "**/*.vue",
        "**/ui/register.ts"
    ]
}
