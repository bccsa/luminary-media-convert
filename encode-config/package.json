        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.2.0",
        "typescript": "~5.7.0",
        "vite": "^6.1.0",
        "vue": "^3.5.0",
        "vue-tsc": "^2.2.0"
    }
