{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "moduleResolution": "bundler",
        "strict": true,
        "declaration": true,
        "declarationDir": "./dist",
        "outDir": "./dist",
        "isolatedModules": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "preserve"
    },
    "include": ["src/**/*.ts", "src/**/*.vue"]
}
