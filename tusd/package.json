{
    "name": "node-tusd",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist",
        "bin"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "download-tusd": "bash scripts/download-tusd.sh",
        "test": "NODE_OPTIONS='--experimental-vm-modules' jest --forceExit"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^22.10.7",
        "jest": "^30.0.0",
        "ts-jest": "^29.2.5",
        "typescript": "^5.7.3"
    },
    "jest": {
        "extensionsToTreatAsEsm": [".ts"],
        "moduleFileExtensions": ["js", "json", "ts"],
        "rootDir": ".",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.ts$": ["ts-jest", { "useESM": true }]
        },
        "moduleNameMapper": {
            "^(\\.{1,2}/.*)\\.js$": "$1"
        },
        "testEnvironment": "node"
    }
}
