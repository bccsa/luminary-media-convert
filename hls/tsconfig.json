{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "lib": ["ES2023"],
        "moduleResolution": "NodeNext",
        "strict": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "isolatedModules": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.spec.ts", "dist"]
}
