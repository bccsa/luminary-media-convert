{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "preserve",
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["env.d.ts", "src/**/*.ts", "src/**/*.vue"]
}
