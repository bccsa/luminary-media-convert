# Auth0 configuration (required) — must match the SaaS service's Auth0 tenant
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier

# Auth0 custom claim namespace — must match the Post Login Action in Auth0
VITE_AUTH0_CLAIM_NAMESPACE=https://luminary.dev

# SaaS service base URL — must match the SaaS service's address
VITE_SAAS_SERVICE_URL=http://localhost:3001
