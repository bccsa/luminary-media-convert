{
    "name": "@luminary-media-converter/segment-editor",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "sideEffects": [
        "**/*.css",
        "**/SegmentEditor.vue"
    ],
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
        "dev": "concurrently -k -n js,dts -c blue,gray \"vite build --watch\" \"vue-tsc --declaration --emitDeclarationOnly --outDir dist --watch --preserveWatchOutput\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.2.0",
        "@vitest/coverage-v8": "^4.1.5",
        "@vue/test-utils": "^2.4.6",
        "jsdom": "^29.0.2",
        "typescript": "~5.7.0",
        "vite": "^6.1.0",
        "vite-plugin-css-injected-by-js": "^3.5.2",
        "vitest": "^4.1.5",
        "vue": "^3.5.0",
        "vue-tsc": "^2.2.0"
    }
}
