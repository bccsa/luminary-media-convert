{
    "name": "@luminary-media-converter/electron",
    "version": "0.0.1",
    "productName": "Luminary Media Convert",
    "private": true,
    "description": "Desktop shell: hosts the Encoding API in the main process and the web client as its renderer",
    "license": "Apache-2.0",
    "main": "dist/main.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "npm run build && electron .",
        "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
        "dist:win": "npm run build && electron-builder --win --config electron-builder.yml",
        "pack": "npm run build && electron-builder --dir --config electron-builder.yml"
    },
    "dependencies": {
        "@luminary-media-converter/api": "*"
    },
    "devDependencies": {
        "electron": "33.4.11",
        "electron-builder": "^26.15.3",
        "typescript": "^5.7.3"
    }
}
